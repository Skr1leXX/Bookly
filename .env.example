# Скопируйте в .env.local (локально) или добавьте в переменные окружения хостинга.
# Реальные ключи в репозиторий не коммитьте: .env.local в .gitignore.

# URL проекта Supabase.
#   локально:   http://127.0.0.1:54321  (выводит `npx supabase start`)
#   в облаке:   Project Settings -> API -> Project URL, вида https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Публичный ключ (anon / publishable). Он безопасен для браузера: доступ к данным
# ограничивают политики RLS. Не вставляйте сюда service_role-ключ:
# приложению он не нужен, и он никогда не должен попадать в клиентский код.
#   локально:   `npx supabase status` -> anon key
#   в облаке:   Project Settings -> API -> anon public (или Publishable key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Адрес сайта для ссылки подтверждения e-mail (необязательно; по умолчанию берётся из запроса).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Необязательно: соль для хэша IP в лимитах публичной записи (любая случайная строка).
BOOKING_RATE_SALT=
